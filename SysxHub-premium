MiT:CreateToggle({Name="Auto Reset When Stuck",CurrentValue=false,Callback=function(v)
    C.Misc.ResetStuck=v
    if v then
        S.Thread.Stuck=task.spawn(function()
            local lp,st=nil,0
            while C.Misc.ResetStuck do
                local h=HRP()
                if h then
                    if lp and (h.Position-lp).Magnitude<1 then
                        st=st+0.5
                        if st>=5 then
                            local hu=GC():FindFirstChildOfClass("Humanoid")
                            if hu then hu.Health=0 end
                            st=0 Ntf("Auto Reset","Stuck terdeteksi ✅")
                        end
                    else st=0 end
                    lp=h.Position
                end
                task.wait(0.5)
            end
        end)
    else ST("Stuck") end
end})

