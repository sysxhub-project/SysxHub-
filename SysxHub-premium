    TweenService:Create(CopyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(240, 240, 245)}):Play()
end)

CopyBtn.Activated:Connect(function()
    local link = "https://discord.gg/E5kQJW3hn"
    if setclipboard then setclipboard(link)
    elseif toclipboard then toclipboard(link) end
    openBrowser(link)
    CopyBtn.Text = "Copied ✓"
    TweenService:Create(CopyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(120, 230, 150)}):Play()
    task.wait(1.5)
    CopyBtn.Text = "Copy & Open Link"
