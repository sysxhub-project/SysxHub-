end)

--// CLOSE ANIMATION
CloseBtn.Activated:Connect(function()
    local out = TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
    for _, v in ipairs({IconBox, BrandLabel, VersionLabel, Title, Subtitle, CopyBtn, CloseBtn}) do
        if v:IsA("TextLabel") or v:IsA("TextButton") then
            TweenService:Create(v, out, {TextTransparency = 1}):Play()
        elseif v:IsA("Frame") then
            TweenService:Create(v, out, {BackgroundTransparency = 1}):Play()
        end
    end
    TweenService:Create(CardStroke, out, {Transparency = 1}):Play()
    TweenService:Create(TopAccent, out, {BackgroundTransparency = 1}):Play()
    TweenService:Create(Card, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
        Position = UDim2.new(0.5, 0, 0.5, -50),
        BackgroundTransparency = 1
    }):Play()
    TweenService:Create(Backdrop, out, {BackgroundTransparency = 1}):Play()
    task.wait(0.55)
    ScreenGui:Destroy()
end)

-- Auto close setelah 90 detik
