local function GetToolByType(t)
    local char=GC() if not char then return nil end
    local bp=LP:FindFirstChild("Backpack")
    local function checkTool(tool)
        if not tool or not tool:IsA("Tool") then return false end
        if t=="Sword" then
            if tool:GetAttribute("SwordType") then return true end
            local n=tool.Name:lower()
            if n:find("sword") or n:find("blade") or n:find("katana") or n:find("saber") or n:find("cutlass") or n:find("trident") or n:find("scythe") or n:find("bisento") or n:find("cane") or n:find("dagger") then return true end
            if tool:FindFirstChild("SwordType") then return true end
        elseif t=="Gun" then
            if tool:GetAttribute("GunType") then return true end
            local n=tool.Name:lower()
            if n:find("gun") or n:find("pistol") or n:find("rifle") or n:find("blaster") or n:find("bow") or n:find("bazooka") or n:find("slingshot") then return true end
            if tool:FindFirstChild("GunType") then return true end
        elseif t=="Blox Fruit" then
            if tool:GetAttribute("FruitType") then return true end
            if tool:FindFirstChild("FruitType") then return true end
        end
        return false
    end
    local eq=char:FindFirstChildOfClass("Tool")
    if eq and checkTool(eq) then return eq end
    if bp then
        for _,tool in ipairs(bp:GetChildren()) do
            if checkTool(tool) then
                pcall(function() char:FindFirstChildOfClass("Humanoid"):EquipTool(tool) end)
                return tool
            end
        end
    end
    for _,tool in ipairs(char:GetChildren()) do
        if checkTool(tool) then return tool end
    end
    return nil
end

local function AttackOnce()
    local char=GC() if not char then return end
    ActivateHaki()
    if C.Tool=="Melee" then
        local eq=char:FindFirstChildOfClass("Tool")
        if eq then pcall(function() char:FindFirstChildOfClass("Humanoid"):UnequipTools() end) end
    elseif C.Tool=="Sword" then
        local t=GetToolByType("Sword") if t then pcall(function() t:Activate() end) end
    elseif C.Tool=="Gun" then
        local t=GetToolByType("Gun") if t then pcall(function() t:Activate() end) end
    elseif C.Tool=="Blox Fruit" then
        local t=GetToolByType("Blox Fruit") if t then pcall(function() t:Activate() end) end
    end
    pcall(function() VU:CaptureController(); VU:Button1Down(Vector2.new(0,0)) end)
    pcall(function() CommF:InvokeServer("Combat","Attack") end)
    pcall(function() if CommE then CommE:FireServer("Combat","Attack") end end)
end

local function AtkTgt(n)
    if not n or not n.Parent then return end
    local h=HRP() if not h then return end
    if n:FindFirstChild("HumanoidRootPart") then
        h.CFrame=n.HumanoidRootPart.CFrame*CFrame.new(0,0,3)
    end
    AttackOnce()
end

local EC,ET={},0
local function GetE()
    if tick()-ET<0.4 then return EC end
    ET=tick() EC={}
    local mc=GC()
    local folders={}
    if WS:FindFirstChild("Enemies") then table.insert(folders,WS.Enemies) end
    if WS:FindFirstChild("NPCs") then table.insert(folders,WS.NPCs) end
    if WS:FindFirstChild("Characters") then table.insert(folders,WS.Characters) end
    for _,f in ipairs(folders) do
        for _,v in ipairs(f:GetChildren()) do
            if v~=mc and v:FindFirstChildOfClass("Humanoid") and v:FindFirstChild("HumanoidRootPart") then table.insert(EC,v) end
        end
    end
    if #EC==0 then
        for _,v in ipairs(WS:GetChildren()) do
            if v~=mc and v:FindFirstChildOfClass("Humanoid") and v:FindFirstChild("HumanoidRootPart") then table.insert(EC,v) end
        end
    end
    return EC
end

local function NEAR()
    local h=HRP() if not h then return nil end
    local n,d=nil,math.huge
    for _,e in ipairs(GetE()) do
        local hu=e:FindFirstChildOfClass("Humanoid")
        if hu and hu.Health>0 then
            local dd=(e.HumanoidRootPart.Position-h.Position).Magnitude
            if dd<d then n,d=e,dd end
        end
    end
    return n
end

local function NAM(nm)
    if nm=="" then return nil end
    for _,e in ipairs(GetE()) do
        if e.Name:lower():find(nm:lower(),1,true) then
            local hu=e:FindFirstChildOfClass("Humanoid")
            if hu and hu.Health>0 then return e end
        end
    end
    return nil
end

local function BOSS()
    for _,e in ipairs(GetE()) do
        local hu=e:FindFirstChildOfClass("Humanoid")
        if hu and hu.Health>0 and hu.MaxHealth>=500 then return e end
    end
    return nil
end

local function SIMILAR()
    local char=GC() if not char then return nil end
    local myHum=char:FindFirstChildOfClass("Humanoid")
    if not myHum then return nil end
    local myHP=myHum.MaxHealth
    local hrp=char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best,bestDist=nil,math.huge
    for _,npc in ipairs(GetE()) do
        local hum=npc:FindFirstChildOfClass("Humanoid")
        local nhrp=npc:FindFirstChild("HumanoidRootPart")
        if hum and nhrp and hum.Health>0 and npc~=char then
            if hum.MaxHealth<=myHP*3 then
                local d=(nhrp.Position-hrp.Position).Magnitude
                if d<bestDist then best,bestDist=npc,d end
            end
        end
    end
    return best
end

local function Tw(p,s)
    local h=HRP() if not h then return end
    s=s or C.Speed
    local d=(h.Position-p).Magnitude
    if d<1 then return end
    TW:Create(h,TweenInfo.new(d/s,Enum.EasingStyle.Linear),{CFrame=CFrame.new(p)}):Play()
end

local function CT(fn)
    return Run.Heartbeat:Connect(function()
        local t=fn() if t then AtkTgt(t) end
    end)
end

local function SL(k) if S.Loop[k] then S.Loop[k]:Disconnect(); S.Loop[k]=nil end end
local function ST(k) if S.Thread[k] then pcall(task.cancel,S.Thread[k]); S.Thread[k]=nil end end

